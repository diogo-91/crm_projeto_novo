enum TaskStatus {
  OPEN
  COMPLETED
}

enum TaskKind {
  TASK
  FOLLOW_UP
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum TaskEventKind {
  CREATED
  UPDATED
  COMPLETED
  REOPENED
  ARCHIVED
}

enum ActivityKind {
  NOTE
  CALL
  EMAIL
  MEETING
}

enum ReminderState {
  PENDING
  DISPATCHED
  COMPLETED
  CANCELED
  FAILED
}

model Task {
  id                    String                 @id @default(uuid()) @db.Uuid
  organizationId        String                 @map("organization_id") @db.Uuid
  branchId              String                 @map("branch_id") @db.Uuid
  ownerMembershipId     String                 @map("owner_membership_id") @db.Uuid
  name                  String                 @db.VarChar(160)
  description           String?                @db.VarChar(4000)
  kind                  TaskKind               @default(TASK)
  priority              TaskPriority           @default(NORMAL)
  status                TaskStatus             @default(OPEN)
  dueAt                 DateTime?              @map("due_at") @db.Timestamptz(6)
  remindAt              DateTime?              @map("remind_at") @db.Timestamptz(6)
  completedAt           DateTime?              @map("completed_at") @db.Timestamptz(6)
  contactId             String?                @map("contact_id") @db.Uuid
  leadId                String?                @map("lead_id") @db.Uuid
  opportunityId         String?                @map("opportunity_id") @db.Uuid
  active                Boolean                @default(true)
  version               Int                    @default(1)
  reminderVersion       Int                    @default(1) @map("reminder_version")
  createdByMembershipId String                 @map("created_by_membership_id") @db.Uuid
  updatedByMembershipId String                 @map("updated_by_membership_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment            MembershipBranch       @relation(fields: [organizationId, ownerMembershipId, branchId], references: [organizationId, membershipId, branchId], onDelete: Restrict, onUpdate: Restrict)
  creator               OrganizationMembership @relation("TaskCreator", fields: [organizationId, createdByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  updater               OrganizationMembership @relation("TaskUpdater", fields: [organizationId, updatedByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  contact               Contact?               @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lead                  Lead?                  @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  opportunity           Opportunity?           @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  history               TaskHistory[]
  reminders             TaskReminder[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, ownerMembershipId, dueAt, id])
  @@index([organizationId, branchId, createdAt, id])
  @@index([organizationId, contactId])
  @@index([organizationId, leadId])
  @@index([organizationId, opportunityId])
  @@map("tasks")
}

model TaskHistory {
  id                String                 @id @default(uuid()) @db.Uuid

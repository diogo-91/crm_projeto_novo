model TaskReminder {
  id                    String                 @id @default(uuid()) @db.Uuid
  organizationId        String                 @map("organization_id") @db.Uuid
  taskId                String                 @map("task_id") @db.Uuid
  recipientMembershipId String                 @map("recipient_membership_id") @db.Uuid

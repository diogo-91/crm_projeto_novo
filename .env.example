# Copiar e preencher, ou executar pnpm env:init (somente desenvolvimento local).
NODE_ENV=development
API_PORT=3001
API_HOST=127.0.0.1
# Nenhum proxy confiável localmente; produção exige IP/CIDR explícito do proxy.
TRUST_PROXY_CIDRS=
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# API, Prisma e worker de lembretes exigem a mesma conexão PostgreSQL.
DATABASE_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT_SECRET: 32 bytes aleatórios em base64url canônica; nunca um valor padrão.
JWT_SECRET=
JWT_ISSUER=crm-api
JWT_AUDIENCE=crm-web
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=2592000
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_IDENTITY_LIMIT=5
AUTH_REFRESH_IP_LIMIT=60
# Somente seed local/testes; senha inicial 12-128 caracteres, nunca registrada em log.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin.demo@example.test
# Opt-in local: capacidade temporária de criar organizações; não concede acesso a outros tenants.
SEED_PLATFORM_PROVISIONING=false

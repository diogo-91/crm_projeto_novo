# Copiar para arquivo privado fora do Git ou cadastrar no Coolify.
# Raw Docker Compose / Traefik do Coolify; um nome distinto por instalação.
CRM_DEPLOYMENT_NAME=crm
CRM_HOST=crm.example.com
COOLIFY_PROXY_NETWORK=coolify
# IP exato do container proxy (/32 ou /128), descoberto na rede acima.
TRUST_PROXY_CIDRS=
NEXT_PUBLIC_API_URL=https://crm.example.com/api/v1
CORS_ORIGINS=https://crm.example.com
LOG_LEVEL=info
POSTGRES_DB=crm
POSTGRES_USER=crm
# Usar senha aleatória hexadecimal para evitar escapes na URL PostgreSQL.
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_PASSWORD=
# 32 bytes aleatórios, base64url sem padding (43 caracteres).
JWT_SECRET=

# Preencher somente antes de executar o profile operations initial-setup.
# Remover INITIAL_ADMIN_PASSWORD e INITIAL_SETUP_CONFIRM após concluir.
INITIAL_SETUP_CONFIRM=
INITIAL_ORGANIZATION_NAME=
INITIAL_BRANCH_NAME=
INITIAL_BRANCH_CODE=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
